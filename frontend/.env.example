# Vacío en local (usa el proxy de Vite → localhost:3001).
# En Vercel / Capacitor: URL pública de la API, sin barra final.
# Ejemplo: https://alquiler-api.vercel.app
VITE_API_URL=

# Push nativo (FCM/APNs). Dejalo apagado hasta tener google-services.json en
# frontend/android/app: sin ese archivo la app Android crashea al registrarse.
VITE_PUSH_ENABLED=false
