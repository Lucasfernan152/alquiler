# Neon Postgres (obligatorio — ya no usamos SQLite)
# Dashboard: https://console.neon.tech → copiá el Connection string
DATABASE_URL="REEMPLAZAR_CON_EL_CONNECTION_STRING_DE_NEON"

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="365d"
PORT=3001

# Local sin Blob: archivos en disco. En Vercel seteá BLOB_READ_WRITE_TOKEN.
UPLOAD_DIR="../uploads"
BLOB_READ_WRITE_TOKEN=""

# Secreto para Vercel Cron (mismo valor en el proyecto API de Vercel)
CRON_SECRET="change-me-cron"

APP_URL="http://localhost:5173"
# Varios orígenes separados por coma (front local + URL de Vercel)
CORS_ORIGIN="http://localhost:5173"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Alquiler <noreply@alquiler.local>"
FIREBASE_SERVICE_ACCOUNT=""
