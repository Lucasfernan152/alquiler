generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  firebaseUid  String?  @unique
  name         String
  phone        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  buildings      Building[]
  tenancies      Tenancy[]
  notifications  Notification[]
  deviceTokens   DeviceToken[]
  payments       Payment[]
  claims         Claim[]       @relation("ClaimAuthor")
  claimResponses Claim[]       @relation("ClaimResponder")
}

model Building {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  address   String
  city      String   @default("")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  properties Property[]
}

model Property {
  id             String   @id @default(cuid())
  buildingId     String
  label          String
  floor          String   @default("")
  notes          String   @default("")
  billSplitMode  String   @default("tenant_pays_all") // tenant_pays_all | split_by_percentage
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  building          Building           @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  tenancies         Tenancy[]
  contracts         Contract[]
  rentChanges       RentChange[]
  billingPeriods    BillingPeriod[]
  claims            Claim[]
  emergencyContacts EmergencyContact[]
}

model Tenancy {
  id               String    @id @default(cuid())
  propertyId       String
  tenantId         String
  sharePercentage  Float     @default(100)
  active           Boolean   @default(true)
  startDate        DateTime  @default(now())
  endDate          DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  tenant   User     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([propertyId, tenantId])
}

model Contract {
  id                  String    @id @default(cuid())
  propertyId          String
  rentAmount          Float
  currency            String    @default("ARS")
  increaseEveryMonths Int       @default(12)
  nextIncreaseDate    DateTime?
  /// ipc | icl | fixed | other
  increaseMethod      String    @default("ipc")
  increaseNote        String    @default("")
  /// % estimado del próximo aumento (IPC/ICL/fijo). El dueño lo actualiza.
  estimatedIncreasePct Float?
  /// JSON array de tipos de factura obligatorios, ej. ["Luz","Gas"]
  requiredInvoiceTypes String   @default("[]")
  filePath            String?
  fileName            String?
  startDate           DateTime
  endDate             DateTime?
  active              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

/// Historial de alquileres / aumentos aplicados (queda aunque se renueve el contrato).
model RentChange {
  id             String   @id @default(cuid())
  propertyId     String
  previousAmount Float?
  newAmount      Float
  increasePct    Float?
  /// initial | applied | manual
  kind           String   @default("manual")
  method         String   @default("")
  note           String   @default("")
  effectiveDate  DateTime
  createdAt      DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, effectiveDate])
}

model BillingPeriod {
  id          String   @id @default(cuid())
  propertyId  String
  label       String
  year        Int
  month       Int
  // Alquiler congelado del mes: el aumento no debe cambiar períodos ya cerrados.
  rentAmount  Float?
  status      String   @default("collecting") // collecting | ready | settled
  readyAt     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  property  Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  invoices  Invoice[]
  payments  Payment[]

  @@unique([propertyId, year, month])
}

model Invoice {
  id              String   @id @default(cuid())
  billingPeriodId String
  type            String
  amount          Float
  filePath        String?
  fileName        String?
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  billingPeriod BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String   @id @default(cuid())
  billingPeriodId String
  tenantId        String
  amount          Float
  proofPath       String?
  proofName       String?
  status          String   @default("pending") // pending | approved | rejected
  reviewNote      String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  billingPeriod BillingPeriod @relation(fields: [billingPeriodId], references: [id], onDelete: Cascade)
  tenant        User          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Claim {
  id           String   @id @default(cuid())
  propertyId   String
  authorId     String
  title        String
  description  String
  status       String   @default("open") // open | in_progress | resolved | closed
  photoPath    String?
  photoName    String?
  response     String   @default("")
  responderId  String?
  assignedTo   String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  property  Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  author    User     @relation("ClaimAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  responder User?    @relation("ClaimResponder", fields: [responderId], references: [id])
}

model EmergencyContact {
  id         String   @id @default(cuid())
  propertyId String
  category   String
  name       String
  phone      String
  notes      String   @default("")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  type        String
  title       String
  body        String
  dataJson    String    @default("{}")
  readAt      DateTime?
  emailSentAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("unknown") // ios | android | web
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
